{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aidulc",
  "version": "0.1.0",
  "identifier": "com.aidulc.app",
  "build": {
    "frontendDist": "../reader"
  },
  "app": {
    "windows": [
      {
        "title": "aidulc 精读工作站",
        "width": 1100,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; img-src 'self' data: blob:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Education",
    "shortDescription": "本地英语精读/跟读工作站",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}